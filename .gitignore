__pycache__/
*.pyc

# Local working-state checkpoints (not for sharing).
*.checkpoint

# Output artifacts from calibration / batch-test scripts.
auto_calib_result.png
batch_result.png
*_warped.png
*_labeled.png
*_warp_raw.png
*_trim_compare.png
*_validate.png
# MIDI file saves
midi_outs/*

# NOTE: *_calib.json is NOT ignored — calibration files are reusable per camera mount.
snapshots/
piano_photos/_*.png
# Recordings: ignore raw PNG frame folders + loose snapshot clutter,
# but keep the bundled metadata (mp4, keys.json, manifest, viz pngs)
# committed so teammates can browse + run detection on the clips.
recordings/_snapshots/
recordings/*/cam0/
/var/folders
